[Unit]
Description=Customer-hosted SRE RCA Worker
After=network-online.target sre-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=sre-rca
Group=sre-rca
WorkingDirectory=/opt/sre-rca/runtime
EnvironmentFile=/etc/sre-rca/sre.env
ExecStart=/opt/sre-rca/bin/sre-worker -config /etc/sre-rca/sre.yaml
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sre-rca

[Install]
WantedBy=multi-user.target
